# Database Configuration
# For local development: Use your local PostgreSQL
# For Railway: Use the DATABASE_URL from Railway PostgreSQL service
DATABASE_URL=postgresql://user:password@localhost:5432/gaming_platform

# JWT Authentication
# IMPORTANT: Generate a strong secret key for production
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Frontend URLs
# For local development
FRONTEND_URL=http://localhost:5173
# For production: Add your Vercel domain(s), comma-separated
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Base URL for referral links (should match your frontend URL)
BASE_URL=https://your-frontend.vercel.app

# App Settings
PROJECT_NAME=Gaming Platform API
VERSION=1.0.0
